    <!-- Screen text. Kept here so the app can be translated. -->
    <string name="blocked_explainer">That block is Android\'s, not Ghostly\'s — it applies to any app installed outside the Play Store. Unlock it once:\n\n1.  Open app info below\n2.  Tap  ⋮  in the top-right corner\n3.  Tap \"Allow restricted settings\"\n4.  Come back and grant \"Display over other apps\"</string>
